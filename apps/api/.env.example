# Postgres connection string
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Auth (admin)
ADMIN_EMAIL=admin@example.com
# bcrypt hash of the admin password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH=$2a$12$REPLACE_ME
JWT_SECRET=change-me-to-a-long-random-string

# AI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set to "true" to disable AI endpoints (returns 503)
AI_DISABLED=false

# Rate limits
CONTACT_RATE_LIMIT_WINDOW_MS=60000
CONTACT_RATE_LIMIT_MAX=5
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
